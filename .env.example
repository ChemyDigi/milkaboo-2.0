# Free the Milkaboo Cup (Halloween game). Copy to .env.local and fill in.

# Signs round tokens (HMAC). At least 32 random characters; required in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GAME_SECRET=

# Counter staff send this as "Authorization: Bearer <token>" to /api/admin/redeem. At least 16 characters.
ADMIN_REDEEM_TOKEN=

# Local development only (ignored in production): skip the 3-tries-per-day limit.
GAME_UNLIMITED_ATTEMPTS=true

# Testing only: makes the game easy to win (30 s, 3 s to free the cup, weak fight-backs, lower mic threshold).
# Shows an "EASY TEST MODE" badge. Restart `npm run dev` after changing it. Never set it in production.
NEXT_PUBLIC_GAME_EASY=false
